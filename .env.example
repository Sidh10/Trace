# Gemini API key — free tier, get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Master switch — AGENTS.md rule 2. The whole pipeline must run end to end
# with this set to false: regex/keyword parsing for supplier messages,
# template strings for narration. Rehearse this mode before the demo.
TRACE_LLM_ENABLED=true

# Optional override for testing. Leave blank to use the spec's sample value
# (see ARCHITECTURE.md §6 sample records).
TRACE_APPROVAL_THRESHOLD=
